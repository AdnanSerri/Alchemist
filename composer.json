{
  "name": "serri/alchemist",
  "description": "The JSON Revolution for Laravel, a simple, fast, and elegant alternative to Laravel JSON Resource. ",
  "license": "MIT",
  "authors": [
    {
      "name": "Adnan Serri",
      "email": "serri.adnan.47@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/pagination": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.14",
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Serri\\Alchemist\\": "src/"
    },
    "files": [
      "src/Helpers/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Serri\\Alchemist\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/Fixtures/Formulas",
      "tests/Fixtures/ModuleFormulas",
      "tests/Fixtures/Octane"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "pint --test",
    "fix": "pint",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Serri\\Alchemist\\Providers\\AlchemistServiceProvider"
      ]
    }
  }
}
