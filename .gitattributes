# Normalise line endings: LF in the repository and in every checkout,
# so Pint's line_ending rule behaves the same on Windows and CI.
* text=auto eol=lf

# Binary-safe exclusions
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Exclude development files from Packagist dist archives
/.github export-ignore
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpunit.xml export-ignore
/phpstan.neon.dist export-ignore
/CLAUDE.md export-ignore
